{
  "manifest_version": 3,
  "name": "xMomentsLater for X",
  "description": "Save X posts and import your X bookmarks into xMomentsLater using your signed-in session.",
  "version": "0.2.0",
  "permissions": ["storage", "windows", "cookies", "scripting"],
  "host_permissions": [
    "https://x.com/*",
    "https://*.x.com/*",
    "https://*.up.railway.app/*",
    "http://localhost/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "xMomentsLater import"
  },
  "content_scripts": [
    {
      "matches": ["*://x.com/*", "*://*.x.com/*", "*://twitter.com/*", "*://*.twitter.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "options_page": "options.html"
}
