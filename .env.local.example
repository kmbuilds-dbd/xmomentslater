# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# X API credentials
NEXT_PUBLIC_X_CLIENT_ID=
X_CLIENT_SECRET=

# App config
NEXT_PUBLIC_APP_URL=http://localhost:3001

# Token encryption (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
TOKEN_ENCRYPTION_KEY=

# Semantic search (Cloudflare Vectorize sidecar + OpenAI embeddings)
VECTOR_SEARCH_WORKER_URL=
VECTOR_SEARCH_SECRET=
SEMANTIC_BACKFILL_ADMIN_EMAILS=
# Configure OPENAI_API_KEY as a Cloudflare Worker secret, not a Next.js env var.
